{
  "name": "provocativelook-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "npm run lint:fix && prettier --write \"src/**/*.{scss,css}\" \"*.json\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,scss,css}\" \"*.{js,ts,json,html}\"",
    "preview": "vite preview",
    "test": "node src/tests/run.mjs",
    "test:integration": "node src/tests/run.mjs --integration",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "test:server": "node src/tests/serverRequests.run.mjs",
    "test:server:write": "node src/tests/serverRequests.run.mjs --write",
    "test:resilience": "node --test src/tests/apiResilience.test.mjs src/tests/phoneCheck.test.mjs src/tests/phone.test.mjs",
    "test:auth:integration": "node --test src/tests/authServer.integration.test.mjs",
    "test:password:integration": "node --test src/tests/passwordReset.integration.test.mjs",
    "test:checkout:integration": "node --test src/tests/checkoutServer.integration.test.mjs",
    "test:audit:unit": "node --test src/tests/apiResilience.test.mjs src/tests/phoneCheck.test.mjs src/tests/phone.test.mjs src/tests/deliveryAddresses.test.mjs src/tests/yandexMaps.test.mjs src/tests/catalogRouting.test.mjs src/tests/checkoutAttempt.test.mjs src/tests/purchasableOffers.test.mjs",
    "test:delivery": "node --test src/tests/deliveryAddresses.test.mjs src/tests/yandexMaps.test.mjs",
    "test:cookies": "node --test src/tests/cookieConsent.test.mjs",
    "test:catalog:integration": "node --test src/tests/catalogServer.integration.test.mjs",
    "test:featured": "node --test src/tests/carouselDots.test.mjs src/tests/carouselWindow.test.mjs src/tests/featuredCatalog.integration.test.mjs",
    "test:featured:browser": "node src/tests/serveFeatured.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-redux": "^9.3.0",
    "react-router": "^7.15.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "3.9.10",
    "sass": "^1.100.0",
    "sharp": "0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
